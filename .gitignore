# Build directories (out-of-source CMake builds: build/, build-asan/, ...)
/*build*/

# CMake in-source safety net (should live under build/, ignore anyway)
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
CTestTestfile.cmake
install_manifest.txt
compile_commands.json
/_deps/

# Generated headers (CMake configures these from *.in)
/config.h
/version.h

# The built binary
/xapiand

# Xapian on-disk databases
*.baseA
*.baseB
*.DB

# Compiled artifacts
*.o
*.obj
*.a
*.lib
*.so
*.dylib
*.dll
*.gch
*.pch
*.exe
*.out
*.app

# Python
*.pyc
*.pyo
__pycache__/

# Editors / IDEs (personal config, not tracked)
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# Caches / OS cruft
.cache/
.DS_Store

# Vendored Xapian (src/xapian/) ships autotools build files; the CMake build
# doesn't use them, and they were never tracked. Keep them out of git status.
src/xapian/**/Makefile
src/xapian/**/Makefile.in
src/xapian/**/Makefile.mk
src/xapian/**/Makefile.am
