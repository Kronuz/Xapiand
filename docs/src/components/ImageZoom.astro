---
/**
 * <ImageZoom /> — click an image or a D2 diagram in the content to see it larger, in a modal
 * over the page; a click anywhere or Escape closes it. Desktop only (a hover-capable fine
 * pointer): on a touch screen, pinch-to-zoom already does this. An image opens only when the
 * modal would show it meaningfully larger: a vector (SVG, so every D2 diagram) scales to fit the
 * window, a raster up to its natural size. The zoom-in cursor (custom.css) marks exactly those
 * images, set on hover. Linked images keep their link, and snippets and code are left alone.
 */
---

<script>
	const desktop = window.matchMedia("(hover: hover) and (pointer: fine)");
	const GAIN = 1.15; // the least enlargement worth opening the modal for
	const FRAME = 96; // window margin plus the image's padding in the modal, in px

	const zoomable = (target: EventTarget | null): HTMLImageElement | null => {
		const img = target instanceof Element ? target.closest("img") : null;
		if (!img || !img.closest(".sl-markdown-content")) return null;
		if (img.closest("a, .snippet, .expressive-code, .not-content")) return null;
		return img;
	};

	// The size the modal would show `img` at, and how much larger that is than on the page.
	const fit = (img: HTMLImageElement) => {
		const shown = img.getBoundingClientRect();
		const width = img.naturalWidth || shown.width;
		const height = img.naturalHeight || shown.height;
		if (!width || !height || !shown.width) return null;
		const vector = /^data:image\/svg|\.svg([?#]|$)/i.test(img.currentSrc || img.src);
		let scale = Math.min((innerWidth - FRAME) / width, (innerHeight - FRAME) / height);
		if (!vector) scale = Math.min(scale, 1);
		return { width: width * scale, height: height * scale, gain: (width * scale) / shown.width };
	};

	// A D2 figure's images are decorative (alt=""); its description is the figcaption.
	const describe = (img: HTMLImageElement) =>
		img.alt || img.closest("figure")?.querySelector("figcaption")?.textContent?.trim() || "Image";

	let dialog: HTMLDialogElement | null = null;
	const open = (img: HTMLImageElement, size: { width: number; height: number }) => {
		if (!dialog) {
			dialog = document.createElement("dialog");
			dialog.className = "kz-zoom";
			dialog.append(document.createElement("img"));
			dialog.addEventListener("click", () => dialog?.close());
			document.body.append(dialog);
		}
		const big = dialog.querySelector("img")!;
		big.src = img.currentSrc || img.src;
		big.alt = describe(img);
		big.style.width = `${Math.round(size.width)}px`;
		big.style.height = `${Math.round(size.height)}px`;
		dialog.setAttribute("aria-label", big.alt);
		dialog.showModal();
	};

	document.addEventListener("mouseover", (event) => {
		const img = zoomable(event.target);
		if (!img || !desktop.matches) return;
		const size = fit(img);
		img.toggleAttribute("data-kz-zoom", Boolean(size && size.gain >= GAIN));
	});

	document.addEventListener("click", (event) => {
		const img = zoomable(event.target);
		if (!img || !desktop.matches) return;
		const size = fit(img);
		if (!size || size.gain < GAIN) return;
		event.preventDefault();
		open(img, size);
	});
</script>
