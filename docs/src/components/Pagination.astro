// Override of Starlight's Pagination: the prev/next links show each destination's
// real page title instead of its sidebar label. Section-landing entries are labeled
// "Overview" in the sidebar (nice under a group), but "Previous: Overview" in the
// pager is ambiguous -- so resolve the actual title from the docs collection by URL,
// falling back to the sidebar label for anything not backed by a page (external links).
import Icon from '../../node_modules/@astrojs/starlight/user-components/Icon.astro';
import { getCollection } from 'astro:content';

const { dir, pagination } = Astro.locals.starlightRoute;
const { prev, next } = pagination;
const isRtl = dir === 'rtl';

const base = import.meta.env.BASE_URL;
const norm = (p: string) => '/' + String(p).replace(/^\/+|\/+$/g, '');
const stripBase = (p: string) => {
	const b = norm(base);
	const n = norm(p);
	return b === '/' ? n : norm(n.slice(b.length));
};

const docs = await getCollection('docs');
const titleBySlug = new Map<string, string>();
for (const e of docs) titleBySlug.set(norm(e.id), e.data.title);

const labelFor = (link: { href: string; label: string } | undefined) => {
	if (!link) return '';
	return titleBySlug.get(stripBase(link.href)) ?? link.label;
};
---

<div class="pagination-links print:hidden" dir={dir}>
	{
		prev && (
			<a href={prev.href} rel="prev">
				<Icon name={isRtl ? 'right-arrow' : 'left-arrow'} size="1.5rem" />
				<span>
					{Astro.locals.t('page.previousLink')}
					<br />
					<span class="link-title">{labelFor(prev)}</span>
				</span>
			</a>
		)
	}
	{
		next && (
			<a href={next.href} rel="next">
				<Icon name={isRtl ? 'left-arrow' : 'right-arrow'} size="1.5rem" />
				<span>
					{Astro.locals.t('page.nextLink')}
					<br />
					<span class="link-title">{labelFor(next)}</span>
				</span>
			</a>
		)
	}
</div>

<style>
	@layer starlight.core {
		.pagination-links {
			display: grid;
			grid-template-columns: repeat(auto-fit, minmax(min(18rem, 100%), 1fr));
			gap: 1rem;
		}

		a {
			display: flex;
			align-items: center;
			justify-content: flex-start;
			gap: 0.5rem;
			width: 100%;
			flex-basis: calc(50% - 0.5rem);
			flex-grow: 1;
			border: 1px solid var(--sl-color-gray-5);
			border-radius: 0.5rem;
			padding: 1rem;
			text-decoration: none;
			color: var(--sl-color-gray-2);
			box-shadow: var(--sl-shadow-md);
			overflow-wrap: anywhere;
		}
		[rel='next'] {
			justify-content: end;
			text-align: end;
			flex-direction: row-reverse;
		}
		a:hover {
			border-color: var(--sl-color-gray-2);
		}

		.link-title {
			color: var(--sl-color-white);
			font-size: var(--sl-text-2xl);
			line-height: var(--sl-line-height-headings);
		}

		svg {
			flex-shrink: 0;
		}
	}
</style>
