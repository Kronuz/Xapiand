---
// Footer links to the GitHub editor and, in development, the local editor.
// Production links appear after the reader opts in with ?editor=on.
import { Icon } from "@astrojs/starlight/components";

const route = Astro.locals.starlightRoute;
const editUrl = route.editUrl as URL | string | undefined;
const githubHref =
	(editUrl ? ((editUrl as URL).href ?? String(editUrl)) : null) ??
	((Astro.locals as Record<string, unknown>).editHref as string | undefined) ??
	null;
const localHref =
	import.meta.env.DEV && route.entry?.filePath
		? `${import.meta.env.BASE_URL.replace(/\/$/, "")}/__open-in-editor?file=${encodeURIComponent(`${process.cwd()}/${route.entry.filePath}`)}`
		: null;
---

{(githubHref || localHref) && (
	<span class:list={["kz-edit-group", "print:hidden", { "kz-editor-only": !import.meta.env.DEV }]}>
		{githubHref && (
			<a class="kz-edit" href={githubHref} target="_blank" rel="noopener noreferrer" title="Edit this page on GitHub">
				<Icon name="pencil" size="1em" /> <span>Edit source</span>
			</a>
		)}
		{localHref && (
			<a class="kz-edit-local" href="#" data-edit={localHref} data-astro-prefetch="false" title="Open the source in your local editor" onclick="event.preventDefault();fetch(this.dataset.edit).catch(()=>{});">
				<Icon name="laptop" size="1em" />
			</a>
		)}
	</span>
)}

<style>
	.kz-edit-group {
		display: inline-flex;
		align-items: center;
		gap: 0.75rem;
	}
	.kz-edit-group a {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-3);
		text-decoration: none;
	}
	.kz-edit-group a:hover {
		color: var(--sl-color-text-accent);
	}
	.kz-editor-only {
		display: none;
	}
	:global(:root[data-editor]) .kz-editor-only {
		display: inline-flex;
	}
</style>
