// Landing-page quick-start OS auto-detect. Sets data-os on the .kz-os widget to the
// visitor's platform (macOS -> brew, Linux/Windows -> docker); the matching command
// shows and the others stay hidden. The markup defaults to data-os="linux" (the
// universal docker command), which is also the no-JS / unknown-OS fallback.
---

<script is:inline>
	(function () {
		var el = document.querySelector(".kz-os");
		if (!el) return;
		var p = ((navigator.userAgentData && navigator.userAgentData.platform) || navigator.platform || navigator.userAgent || "").toLowerCase();
		var os = /mac|iphone|ipad|ipod/.test(p) ? "mac" : /win/.test(p) ? "windows" : "linux";
		el.setAttribute("data-os", os);
	})();
</script>
