---
// Landing-page quick-start OS auto-detect. Sets data-os on the .kz-os widget to the
// visitor's platform (macOS -> brew, Linux/Windows -> docker) and wires the small
// picker so it can be overridden. The markup defaults to data-os="linux" (the
// universal docker command), which is also the no-JS / unknown-OS fallback.
---

<script is:inline>
	(function () {
		var el = document.querySelector(".kz-os");
		if (!el) return;
		var set = function (os) { el.setAttribute("data-os", os); };
		var p = ((navigator.userAgentData && navigator.userAgentData.platform) || navigator.platform || navigator.userAgent || "").toLowerCase();
		if (/mac|iphone|ipad|ipod/.test(p)) set("mac");
		else if (/win/.test(p)) set("windows");
		else set("linux");
		el.querySelectorAll(".kz-os-pick button").forEach(function (b) {
			b.addEventListener("click", function () { set(b.getAttribute("data-os")); });
		});
	})();
</script>
